# Copier ce fichier en « .env » et l'adapter.

# Adresse IP du NAS sur laquelle l'application écoute, et port
# (8765 pour ne pas entrer en conflit avec un autre service déjà sur 8080, ex. Kitsu)
BIND_IP=10.10.30.56
PORT=8765

# Dossier où sont stockés la base et les scénarios (sur le NAS)
DATA_DIR=./data

# Identifiants de l'utilisateur NAS propriétaire de DATA_DIR (commande : id)
PUID=1000
PGID=1000

# Mot de passe d'accès (recommandé). Laisser vide pour désactiver.
SCENARIO_USER=scenario
SCENARIO_PASSWORD=

# Taille maximale d'un fichier déposé (Mo)
SCENARIO_MAX_UPLOAD_MB=50
